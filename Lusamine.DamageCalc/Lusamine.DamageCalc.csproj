<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <PackageId>Lusamine.DamageCalc</PackageId>
    <Version>1.3.0</Version>
    <Description>A Pokémon damage calculator library supporting generations 1 to 9, ported from @smogon/calc. Includes all game mechanics: natures, EVs/IVs, abilities, items, weather, terrain, Z-moves, Max moves, and Terastallization.</Description>
    <PackageTags>pokemon;damage;calculator;smogon;competitive</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/SlimSeb/Lusamine.DamageCalc</RepositoryUrl>
    <PackageProjectUrl>https://github.com/SlimSeb/Lusamine.DamageCalc</PackageProjectUrl>

    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>DamageCalc</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\dex-species.json">
      <LogicalName>Lusamine.DamageCalc.Data.dex-species.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Data\dex-moves.json">
      <LogicalName>Lusamine.DamageCalc.Data.dex-moves.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Data\dex-items.json">
      <LogicalName>Lusamine.DamageCalc.Data.dex-items.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Data\dex-abilities.json">
      <LogicalName>Lusamine.DamageCalc.Data.dex-abilities.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Data\dex-types.json">
      <LogicalName>Lusamine.DamageCalc.Data.dex-types.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Data\dex-natures.json">
      <LogicalName>Lusamine.DamageCalc.Data.dex-natures.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\README.md">
      <Link>README.md</Link>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.8" />
  </ItemGroup>
</Project>
